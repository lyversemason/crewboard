{
  "name": "soccer-sessions",
  "private": true,
  "version": "2.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src tests",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "tsc -b && oxlint src tests && vitest run",
    "screenshots": "node scripts/screenshots.mjs",
    "db:start": "tsx scripts/build-functions.ts && supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && tsx scripts/db-seed.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "dev:live": "tsx scripts/dev-live.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.64.0",
    "supabase": "^2.122.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
